# Copy this file to .dev.vars for local development. Never commit .dev.vars.
# The URL is the deployed Google Apps Script /exec endpoint.
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec
NOTIFICATION_CRON_SECRET=replace-with-random-secret

# Must exactly match the SABUTH_SECRET Script Property in Google Apps Script.
GOOGLE_SCRIPT_SECRET=replace-with-the-private-hmac-secret

# JSON object containing PBKDF2 salts and hashes for the five Sabuth users.
# Generate this locally with: node scripts/generate-team-credentials.mjs
SABUTH_TEAM_CREDENTIALS={"Prabhakar":{"salt":"replace","hash":"replace"},"Preetham":{"salt":"replace","hash":"replace"},"Raghu":{"salt":"replace","hash":"replace"},"Junior2":{"salt":"replace","hash":"replace"},"Junior3":{"salt":"replace","hash":"replace"}}
